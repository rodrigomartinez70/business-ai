# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=negocio_admin
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=negocio_db
NEGOCIO_USER_PASSWORD=negocio_user_password
NEGOCIO_INGEST_PASSWORD=ingest_password_change_me  # debe coincidir con init.sql

# ─── Discord bot (opcional) ───────────────────────────────────
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# ─── Alertas diarias vía Discord webhook (opcional) ───────────
# Si está vacío, el cron calcula los KPIs pero no los envía a Discord.
# Crear un webhook en: Discord → canal → Configuración → Integraciones → Webhooks
DISCORD_WEBHOOK_URL=

# ─── Web UI ───────────────────────────────────────────────────
# Generar hash bcrypt para el acceso a Adminer:
#   caddy hash-password --plaintext tu_password
ADMINER_HASH=$$2a$$14$$reemplaza_con_hash_bcrypt
WEBUI_SECRET_KEY=cambia_este_secret
# Debe coincidir con business.model_id en config.yaml
WEBUI_DEFAULT_MODEL=asistente-ia

# ─── API Keys por rol ─────────────────────────────────────────
# Agregar/quitar según los roles definidos en config.yaml
API_KEY_GERENTE=genera_un_token_seguro_aqui
API_KEY_ADMINISTRACION=genera_un_token_seguro_aqui
API_KEY_RECEPCION=genera_un_token_seguro_aqui

# ─── LLMs ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-tu-clave-aqui
OLLAMA_MODEL=llama3.2:3b
# Modelo de Claude para generación de SQL y planificación
CLAUDE_MODEL=claude-haiku-4-5

# ─── Config de negocio ────────────────────────────────────────
# Ruta dentro del contenedor (montada como volumen en docker-compose.yml)
# No cambiar salvo que muevas config.yaml a otra ubicación.
BUSINESS_CONFIG_PATH=/app/config.yaml

# ─── Dashboard semanal por correo ─────────────────────────────
# Canal de envío del reporte semanal: "email" o "none" (no enviar).
REPORT_CHANNEL=email
# Servidor SMTP (ej. Gmail: smtp.gmail.com:587 con app password; SendGrid; etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Remitente (si vacío usa SMTP_USER) y destinatarios (coma-separado)
SMTP_FROM=
REPORT_EMAIL_TO=dueno@ejemplo.com
